# ==========================================
# PostgreSQL
# ==========================================
POSTGRES_DB=karting_db
POSTGRES_USER=karting_user
POSTGRES_PASSWORD=change-me

# ==========================================
# Spring Boot (внутри Docker)
# ==========================================
DB_HOST=postgres
DB_PORT=5432

# ==========================================
# Бизнес-настройки
# ==========================================
KARTING_TRACK_SLUG=narvskaya
KARTING_BASE_URL=https://timing.batyrshin.name/tracks
KARTING_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# ==========================================
# Live-тайминг (можно не задавать — есть значения по умолчанию)
# ==========================================
KARTING_LIVE_ENABLED=true
KARTING_LIVE_WS_URL=wss://timing.batyrshin.name/ws
KARTING_LIVE_ORIGIN=https://timing.batyrshin.name
KARTING_LIVE_STALE_SECONDS=180

# ==========================================
# Часовой пояс и ночной режим опроса сайта
# Время в расписании — локальное (по умолчанию Europe/Moscow).
# Днём опрос каждые 30 секунд, ночью — раз в 10 минут.
# Заезды идут примерно с 09:45 до 22:00, окно 23:00–08:00.
# ==========================================
KARTING_TZ=Europe/Moscow
KARTING_POLLING_DAY_INTERVAL=30s
KARTING_POLLING_NIGHT_INTERVAL=10m
KARTING_POLLING_NIGHT_START=23:00
KARTING_POLLING_NIGHT_END=08:00
KARTING_POLLING_DAY_PREFETCH_LIMIT=30
KARTING_POLLING_NIGHT_PREFETCH_LIMIT=5
KARTING_POLLING_NIGHT_RECONNECT_DELAY=10m

# ==========================================
# Grafana (профиль observability)
# Логин/пароль администратора. Порты 3000/9090 слушают только localhost.
# ==========================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
